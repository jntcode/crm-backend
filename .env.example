# Copy to .env (or export in your shell) before running locally.
# The dev profile (default) works with only JWT_SECRET; prod requires everything.

# dev | prod — defaults to dev when unset
SPRING_PROFILES_ACTIVE=dev

# Required in every profile. HS256 signing key, minimum 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Required when SPRING_PROFILES_ACTIVE=prod. Render binds these automatically
# from the database block in render.yaml.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm
DB_USERNAME=crm
DB_PASSWORD=change-me

# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: enables Google ID-token login at /api/auth/google.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
